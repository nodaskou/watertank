[Unit]
Description=Wirewave Network Infrastructure Monitor
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pingmon
Group=pingmon
WorkingDirectory=/opt/pingmonitor
# __BIND_HOST__ is replaced by install.sh. Default 0.0.0.0: LAN users open
# http://<LAN-IP>:8080 and cloudflared on this machine uses http://localhost:8080.
ExecStart=/opt/pingmonitor/venv/bin/python /opt/pingmonitor/pingmonitor.py --db /opt/pingmonitor/data/pingmonitor.db --host __BIND_HOST__ --port 8080
Restart=always
RestartSec=10
# exit code 2 = no admin password yet -> run: sudo -u pingmon /opt/pingmonitor/venv/bin/python /opt/pingmonitor/pingmonitor.py --db /opt/pingmonitor/data/pingmonitor.db --set-password
RestartPreventExitStatus=2
# ICMP without root (fallback if ping_group_range is not set) + allow ports < 1024 if you choose them
# (e-mail receiver on 25, SNMP trap receiver on udp 162)
AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pingmonitor/data
PrivateTmp=true
MemoryMax=200M
Nice=5

[Install]
WantedBy=multi-user.target
